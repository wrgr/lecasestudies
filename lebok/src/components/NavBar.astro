---
// Top navigation. One link list, rendered as a horizontal bar on wide screens
// and a <details> disclosure on narrow ones; CSS swaps which is visible. No JS.
// The Learning Engineering Commons link is external — the shared corpus lives
// there and is linked to, not duplicated here.
interface Props {
  active?: string;
}

const { active } = Astro.props;
const base = import.meta.env.BASE_URL;

const items = [
  { href: base, label: "Home", slug: "home" },
  { href: base + "journeys/", label: "Learning Journeys", slug: "journeys" },
  { href: base + "knowledge-map/", label: "Knowledge Map", slug: "knowledge-map" },
  { href: base + "about/", label: "About", slug: "about" },
  { href: "https://lebok.wiki", label: "LEBoK Wiki", slug: "lebok-wiki", external: true },
  { href: "https://lecommons.org", label: "LE Commons", slug: "lecommons", external: true },
];

const activeLabel = items.find((it) => it.slug === active)?.label ?? "Menu";
---

<header class="site-nav">
  <div class="nav-inner">
    <a href={base} class="brand" aria-label="Home">
      <span class="brand-mark">LE</span>
      <span class="brand-text">Body of Knowledge</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary">
      <ul>
        {items.map((it) => (
          <li>
            <a
              href={it.href}
              class:list={[{ active: it.slug === active }]}
              target={it.external ? "_blank" : undefined}
              rel={it.external ? "noopener" : undefined}
            >
              {it.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <details class="mobile-nav">
      <summary aria-label="Toggle navigation menu">
        <span class="current">{activeLabel}</span>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </summary>
      <nav aria-label="Primary (mobile)">
        <ul>
          {items.map((it) => (
            <li>
              <a
                href={it.href}
                class:list={[{ active: it.slug === active }]}
                target={it.external ? "_blank" : undefined}
                rel={it.external ? "noopener" : undefined}
              >
                {it.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-nav {
    border-bottom: 1px solid var(--border);
    background: var(--bg);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .nav-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: .75rem var(--page-pad);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: .55rem;
    color: var(--ink);
    border: none;
    font-family: var(--serif);
    flex-shrink: 0;
  }
  .brand-mark {
    display: inline-grid;
    place-items: center;
    min-width: 1.8rem;
    height: 1.8rem;
    padding: 0 .35rem;
    background: var(--accent);
    color: var(--bg);
    font-family: var(--sans);
    font-size: .8rem;
    font-weight: 700;
    letter-spacing: .02em;
    border-radius: 2px;
  }
  .brand-text { font-size: 1rem; font-weight: 600; white-space: nowrap; }

  .desktop-nav { display: none; }
  .desktop-nav ul {
    list-style: none;
    margin: 0; padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: .1rem;
    justify-content: flex-end;
  }
  .desktop-nav a {
    font-family: var(--sans);
    font-size: .85rem;
    color: var(--ink-soft);
    border: none;
    padding: .35rem .65rem;
    border-radius: 3px;
    white-space: nowrap;
  }
  .desktop-nav a:hover { background: var(--tint); color: var(--accent); }
  .desktop-nav a.active { color: var(--accent); background: var(--tint-warm); }

  .mobile-nav {
    width: 100%;
    flex: 0 0 100%;
    display: flex;
    justify-content: flex-start;
    position: relative;
  }
  .mobile-nav summary {
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    padding: .35rem .65rem;
    font-family: var(--sans);
    font-size: .82rem;
    color: var(--ink-soft);
    background: var(--tint);
    border: 1px solid var(--border);
    border-radius: 3px;
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
  }
  .mobile-nav summary::-webkit-details-marker { display: none; }
  .mobile-nav summary .current { font-weight: 500; color: var(--accent); letter-spacing: .02em; }
  .mobile-nav[open] summary { background: var(--tint-warm); border-color: var(--accent); color: var(--accent); }
  .mobile-nav nav {
    position: absolute;
    left: 0;
    top: calc(100% + .45rem);
    width: min(19rem, calc(100vw - (var(--page-pad) * 2)));
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    box-shadow: 0 8px 24px rgba(20, 50, 74, 0.12);
    overflow: hidden;
  }
  .mobile-nav ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .mobile-nav nav a {
    display: block;
    font-family: var(--sans);
    font-size: .95rem;
    color: var(--ink-soft);
    border: none;
    padding: .6rem .5rem;
    border-bottom: 1px solid var(--border);
  }
  .mobile-nav nav a:hover { background: var(--tint); color: var(--accent); }
  .mobile-nav nav a.active { color: var(--accent); background: var(--tint-warm); font-weight: 600; }

  @media (max-width: 460px) {
    .brand-text { display: none; }
    .nav-inner { gap: .55rem; }
    .mobile-nav summary .current { display: none; }
  }

  @media (min-width: 900px) {
    .nav-inner { flex-wrap: nowrap; }
    .desktop-nav { display: block; }
    .mobile-nav  { display: none; }
  }
</style>
