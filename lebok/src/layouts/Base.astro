---
// Shared page shell: metadata, global styles, nav, footer.
// A field-level Learning Engineering Body of Knowledge reader — not the LENS
// program site. Palette is a neutral navy/gold so the site reads as a shared
// field reference rather than one institution's brand.
import NavBar from "../components/NavBar.astro";

interface Props {
  title: string;
  description?: string;
  active?: string;
}

const {
  title,
  description = "A guided reader for the field's Learning Engineering Body of Knowledge — curated journeys through what learning engineers know and do.",
  active,
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={base + "favicon.svg"} />
    <slot name="head" />
  </head>
  <body>
    <NavBar active={active} />
    <main>
      <slot />
    </main>
    <footer>
      <div class="footer-inner">
        <div class="footer-brand">
          <strong>Learning Engineering Body of Knowledge</strong>
          <span class="muted">
            · A guided reader over the field's shared body of knowledge. The canonical
            corpus — reading list, tools, practice library, events, community — lives at
            <a href="https://lecommons.org" target="_blank" rel="noopener">lecommons.org</a>
            and the <a href="https://lebok.wiki" target="_blank" rel="noopener">LEBoK wiki</a>;
            this site links to it, and does not replace it.
          </span>
        </div>
        <nav class="footer-links" aria-label="Footer">
          <a href={base + "about/"}>About</a>
          <a href="https://lebok.wiki" target="_blank" rel="noopener">LEBoK Wiki</a>
          <a href="https://lecommons.org" target="_blank" rel="noopener">LE Commons</a>
          <a href="https://sagroups.ieee.org/icicle/" target="_blank" rel="noopener">IEEE ICICLE</a>
        </nav>
      </div>
      <div class="footer-copy">© 2026 · a community field resource</div>
    </footer>

    <style is:global>
      :root {
        --bg:        #fdfcf9;
        --ink:       #14213a;
        --ink-soft:  #2b3654;
        --muted:     #6a7185;
        --accent:    #14324a;
        --accent-2:  #a9762a;
        --gold:      #e9c46a;
        --border:    #e5e2d9;
        --tint:      #f4f2ea;
        --tint-warm: #f6efdd;

        --serif: "Charter", "Iowan Old Style", Georgia, "Times New Roman", serif;
        --sans:  -apple-system, BlinkMacSystemFont, "Inter", "Helvetica Neue", Arial, sans-serif;
        --mono:  ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;

        --measure: 40rem;
        --page-pad: clamp(1rem, 4vw, 2.5rem);
      }

      *, *::before, *::after { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      html { overflow-x: hidden; }
      body {
        background: var(--bg);
        color: var(--ink);
        font-family: var(--serif);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      img, svg, video { max-width: 100%; height: auto; }
      h1, h2, h3, h4, p, li, blockquote { overflow-wrap: break-word; }
      a { overflow-wrap: anywhere; }

      a { color: var(--accent-2); text-decoration: none; border-bottom: 1px solid transparent; transition: border-color .15s ease; }
      a:hover { border-bottom-color: var(--accent-2); }

      pre {
        max-width: 100%;
        overflow-x: auto;
        padding: .7rem .8rem;
        border: 1px solid var(--border);
        border-radius: 4px;
        background: var(--tint);
      }
      code { font-family: var(--mono); font-size: .9em; }

      main { min-height: calc(100vh - 120px); padding-bottom: 4rem; }

      h1, h2, h3, h4 {
        font-family: var(--serif);
        font-weight: 600;
        line-height: 1.2;
        color: var(--ink);
        margin: 0 0 .6em 0;
      }
      h1 { font-size: clamp(2rem, 5vw, 3rem); letter-spacing: -0.01em; }
      h2 { font-size: clamp(1.4rem, 3vw, 1.8rem); }
      h3 { font-size: 1.15rem; font-weight: 600; }

      p { margin: 0 0 1em 0; max-width: var(--measure); }
      .muted { color: var(--muted); }

      .eyebrow {
        font-family: var(--sans);
        font-size: .75rem;
        letter-spacing: .18em;
        text-transform: uppercase;
        color: var(--accent-2);
        margin: 0 0 1rem 0;
      }

      .container {
        max-width: 60rem;
        margin: 0 auto;
        padding: 2.5rem var(--page-pad);
      }
      .container-wide {
        max-width: 72rem;
        margin: 0 auto;
        padding: 2.5rem var(--page-pad);
      }

      hr.rule { border: none; border-top: 1px solid var(--border); margin: 2.5rem 0; }

      footer { border-top: 1px solid var(--border); background: var(--tint); margin-top: 4rem; }
      .footer-inner {
        max-width: 72rem;
        margin: 0 auto;
        padding: 1.25rem var(--page-pad);
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1.5rem;
        flex-wrap: wrap;
        font-family: var(--sans);
        font-size: .85rem;
      }
      .footer-brand { max-width: 42rem; }
      .footer-brand strong { font-family: var(--serif); font-weight: 600; }
      .footer-links { display: flex; gap: 1.2rem; flex-wrap: wrap; }
      .footer-links a { color: var(--muted); border: none; }
      .footer-links a:hover { color: var(--accent-2); }
      .footer-copy {
        max-width: 72rem;
        margin: 0 auto;
        padding: 0 var(--page-pad) 1rem;
        font-family: var(--sans);
        font-size: .75rem;
        color: var(--muted);
        letter-spacing: .04em;
      }
    </style>
  </body>
</html>
